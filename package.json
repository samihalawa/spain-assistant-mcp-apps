{
  "name": "spain-assistant-mcp-apps",
  "version": "0.6.1",
  "private": false,
  "type": "module",
  "description": "Seven evidence-grounded Spanish public-data MCP Apps with accessible interactive views",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/server.js && node --check src/widget.js",
    "build": "node src/build.js",
    "build:fixture": "node tests/build-fixture.js",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "test:live": "node tests/live-smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
